<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tunnel traffic, sockets of the core. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Default network monitor, interface list, connection owner lookup. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ConnectivityManager.requestNetwork() for the underlying default network (API 28-30). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- WIFI state for wifi_ssid/wifi_bssid rules. Reading the SSID additionally
         needs location permissions, which the host app has to declare and request
         itself if it uses such rules. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Foreground VPN service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Service notification (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- setServiceOptions({startOnBoot: true}). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="com.qusadprod.sing_box.service.SingBoxVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name="com.qusadprod.sing_box.service.SingBoxTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@android:drawable/ic_lock_lock"
            android:label="VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name="com.qusadprod.sing_box.service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
