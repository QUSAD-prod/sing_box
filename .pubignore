# Files that must not be published to pub.dev.
# A .pubignore replaces the .gitignore of its directory for publishing, so the
# relevant .gitignore rules are repeated here.

# Native libbox binaries - downloaded at build time from GitHub releases.
android/libs/
ios/sing_box/Frameworks/
ios/Frameworks/
*.xcframework
*.xcframework.zip
*.aar

# Build outputs and caches
build/
**/build/
**/.dart_tool/
**/.gradle/
**/Pods/
**/Podfile.lock
**/.symlinks/
**/Flutter/ephemeral/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/local.properties
**/*.iml
**/.idea/
**/.vscode/
**/xcuserdata/
.DS_Store

# Repository tooling and maintainer docs
.github/
CONTRIBUTING.md
doc/releasing.md
doc/releasing.ru.md

# Local files
/pubspec.lock
/coverage/
**/.swiftpm/
**/.build/
*.class
*.log
