# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Android local properties (may contain local paths)
**/local.properties

# Native libbox binaries. They are built by scripts/build_libbox.sh and
# published as GitHub release assets; Gradle and CocoaPods/SwiftPM download
# them on demand, so they are never committed.
/android/libs/
/ios/Frameworks/
/ios/sing_box/Frameworks/
*.xcframework.zip
